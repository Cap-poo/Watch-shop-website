
/*External CSS*/

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, Helvetica, sans-serif;
    color: #fff;
  }

  /*Styling the navigation bar*/

  #nav {
    height: 100px;
    width: 100%;
    background-color: #000;
    display: flex;
    align-items: center;
    padding: 0 120px;
    gap: 50px;
    position: fixed;
    justify-content: flex-start;
    padding-left: 28%;
    z-index: 999;
  }
  #nav img {
    height: 100px;
    border-radius: 50%;
  }
  #nav h4 {
    text-transform: uppercase;
    cursor: pointer;
  }
  #nav h4 a{
    text-decoration: none;
  }

  /*adding a hover effect*/
  #nav h4 a:hover{
    color: #e4b64b;
  }

  /* Footer Styling */
  #footer {
    display: flex;
    justify-content: space-around;
    align-items: flex-start;
    padding: 20px 10px;
    background-color: #121212;
    color: white;
    border-top: 2px solid #f1ab0a;
    margin-top: 50px;
    flex-wrap: wrap;
    text-align: center;
}

#footer h3, #footer h4 {
    margin: 8px 0;
    font-size: 16px;
    color: white;
}

#footer h4 {
    color: #ccc;
    font-size: 14px;
    line-height: 1.5;
}

#f1 img {
    width: 120px;
    height: auto;
    border-radius: 10px;
}

#f2, #f3, #f4 {
    text-align: center;
    flex: 1;
    min-width: 180px;
    margin: 8px;
}

#f2 h3, #f3 h3 {
    cursor: pointer;
    transition: color 0.3s ease;
    color: white;
}

#f3 h3:hover {
    color: #f1ab0a;
}

#f3 h3 a {
    text-decoration: none;
    color: inherit;
    transition: color 0.3s ease;
}

#f3 h3 a:hover {
    color: #f1ab0a;
}

