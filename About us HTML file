    <style>
        * {
            padding: 0;
            margin: 0;
            box-sizing: border-box;
            text-decoration: none;
        }

        /* Team Section Styling */
        .team {
            padding: 150px 5%;
            width: 100%;
            background: #212121;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            padding-bottom: 50px;
        }

        /* Container Holding Team Members */
        .team-content {
            width: 90%;
            max-width: 1200px;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-around;
            gap: 40px;
            text-align: center;
            margin-top: 40px;
        }

        /* Member Boxes */
        .box {
            width: 220px;
            padding: 20px;
            background: #fff;
            border: 8px solid #ececec;
            border-radius: 15px;
            transition: 0.3s ease;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* Hover Effect */
        .box:hover {
            transform: translateY(-10px);
            cursor: pointer;
        }

        /* Team Member Images */
        .box img {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            margin-bottom: 10px;
        }

        /* Member Name */
        .box h3 {
            font-size: 18px;
            font-weight: 600;
            color: #172c66;
            margin-bottom: 5px;
        }

        /* Member ID */
        .box h5 {
            font-size: 14px;
            font-weight: 500;
            color: burlywood;
        }

        /* Centered Section Title */
        .center {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .center span {
            font-size: 36px;
            color: #6e6658;
        }

        .center h1 {
            color: #73836a;
            font-size: 48px;
            text-align: center;
            font-weight: 600;
        }

        /* Contact Us Section */
        .contact-section {
            padding: 50px 5%;
            background: #2f2929;
            color: #fff;
            text-align: center;
        }

        .contact-section h2 {
            font-size: 36px;
            margin-bottom: 20px;
        }

        .contact-section form {
            max-width: 600px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .contact-section input,
        .contact-section textarea {
            padding: 10px;
            font-size: 16px;
            border: 1px solid #ccc;
            border-radius: 5px;
            background: #fff;
            color: #000;
        }

        .contact-section textarea {
            resize: vertical;
            height: 150px;
        }

        .contact-section button {
            padding: 10px 20px;
            font-size: 18px;
            background: #f1ab0a;
            color: #fff;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: background 0.3s ease;
        }

        .contact-section button:hover {
            background: #e4b64b;
        }

        .error-message {
            color: #f44336;
            font-size: 14px;
            margin-top: 5px;
            display: none;
        }

        /* Footer Styling */
        #footer {
            display: flex;
            justify-content: space-around;
            align-items: flex-start;
            padding: 20px 10px;
            background-color: #121212;
            color: white;
            border-top: 2px solid #f1ab0a;
            margin-top: 0;
            flex-wrap: wrap;
            text-align: center;
        }
    </style>
</head>

