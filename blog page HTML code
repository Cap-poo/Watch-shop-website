    <link rel="stylesheet" href="../css/style.css">
    <style>
        body {
            background: #000; 
            color: #fff; 
        }

        .container {
            padding-top: 120px; 
            text-align: center;
        }

        .column-card {
            display: flex;
            justify-content: space-around;
            flex-wrap: wrap;
            margin: 20px 0;
        }

        .card {
            background: #1a1a1a;
            border-radius: 10px;
            padding: 20px;
            width: 30%;
            margin: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
        }

        .card img {
            width: 100%;
            border-radius: 10px;
        }

        .card h3 {
            margin: 15px 0;
            font-size: 24px;
        }

        .card p {
            font-size: 16px;
            line-height: 1.5;
        }

        .card a {
            color: #e4b64b;
            text-decoration: none;
        }

        .card a:hover {
            text-decoration: underline;
        }

        .horizontal-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin: 20px 0;
        }

        .hcard {
            background: #1a1a1a; 
            border-radius: 10px;
            display: flex;
            align-items: center;
            padding: 20px;
            width: 80%;
            margin: 10px 0;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
        }

        .hcard img {
            width: 40%;
            border-radius: 10px;
            margin-right: 20px;
        }

        .hcard .text {
            width: 60%;
        }

        .hcard h3 {
            margin: 0 0 15px 0;
            font-size: 24px;
        }

        .hcard p {
            font-size: 16px;
            line-height: 1.5;
        }

        /* Clock Styling */
        #clock {
            position: fixed;
            top: 10px;
            right: 10px;
            font-size: 1.2rem;
            color: #e4b64b;
            background: rgba(0, 0, 0, 0.7);
            padding: 10px;
            border-radius: 5px;
            z-index: 1000;
        }
    </style>
</head>
